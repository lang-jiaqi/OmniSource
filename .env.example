# Copy this file to `.env` and fill in what your track's `llm.provider` needs.
# `.env` is gitignored. In CI these become GitHub Actions secrets.

# provider: openai  (default)
OPENAI_API_KEY=

# provider: anthropic
ANTHROPIC_API_KEY=

# provider: local  (Ollama / vLLM / LM Studio, OpenAI-compatible)
# OPENAI_BASE_URL=http://localhost:11434/v1

# provider: openai_compatible  (Gemini, Qwen, hosted gateways, lab endpoints,
# or self-managed OpenAI-compatible APIs)
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_BASE_URL=http://your-endpoint/v1
# Gemini: https://generativelanguage.googleapis.com/v1beta/openai/
# Qwen/DashScope: https://dashscope.aliyuncs.com/compatible-mode/v1
# Optional for slower gateways.
OPENAI_COMPATIBLE_TIMEOUT_SECONDS=300
OPENAI_COMPATIBLE_MAX_RETRIES=2

# source: reddit  (official OAuth — register an app at reddit.com/prefs/apps)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# source: twitter (mode: apify) — paid third-party scraper
APIFY_TOKEN=
